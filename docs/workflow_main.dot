digraph main {
  graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=13, nodesep=0.3, ranksep=0.45, compound=true];
  node [shape=box, style="rounded,filled", fillcolor=white, fontname="DejaVu Sans", fontsize=11];
  edge [color="#8a8a8a", arrowsize=0.6];
  subgraph cluster_0 { label="00_Data 输入与预处理"; style="rounded,filled"; fillcolor="#e8f1fb"; color="#bbbbbb";
    "genome_input";
    "rename_seqids";
    "fastp";
    "homolog_clean";
    "homolog_prep";
    "protein_db";
  }
  subgraph cluster_1 { label="01_Repeat 重复序列"; style="rounded,filled"; fillcolor="#fdf0e3"; color="#bbbbbb";
    "repeat_famdb_setup";
    "edta";
    "repeatmasker";
  }
  subgraph cluster_2 { label="02_RNA 比对与 EviAnn"; style="rounded,filled"; fillcolor="#e9f6ec"; color="#bbbbbb";
    "hisat2_index";
    "hisat2_align";
    "minimap2_align";
    "merge_bam";
    "stringtie";
    "lr_sample_chains";
    "lr_read_chains";
    "eviann_reads";
    "eviann";
    "eviann_split";
  }
  subgraph cluster_3 { label="03_Ab_initio BRAKER4"; style="rounded,filled"; fillcolor="#f3ecfa"; color="#bbbbbb";
    "braker4_inputs";
    "braker4";
    "braker4_gff";
  }
  subgraph cluster_4 { label="04_Homology 同源"; style="rounded,filled"; fillcolor="#fbeef0"; color="#bbbbbb";
    "gemoma";
    "gemoma_gff";
    "miniprot";
  }
  subgraph cluster_5 { label="05_EVM 整合·调优·修正·最终"; style="rounded,filled"; fillcolor="#fff8dc"; color="#bbbbbb";
    "agat_normalize";
    "evm_inputs";
    "evm_impl_check";
    "evm_tune_inputs";
    "evm_tune_weights";
    "evm_tune_run";
    "evm_tune_score";
    "evm";
    "refine";
    "final_pep";
    "final_tesorter";
    "final_filter";
    "final_names";
    "final_export";
    "final_longest";
  }
  subgraph cluster_6 { label="06_Function 功能注释"; style="rounded,filled"; fillcolor="#eaf4f4"; color="#bbbbbb";
    "func_split";
    "interproscan_setup";
    "interproscan";
    "eggnog";
    "kegg_pathway_names";
    "merge_function";
  }
  report [label="07_Report 图文报告\n（汇总各步骤统计与 BUSCO/OMArk/AGAT 质控）", shape=box, style="rounded,filled", fillcolor="#f0f0f0"];
  "agat_normalize" -> "evm_inputs";
  "braker4" -> "braker4_gff";
  "braker4_gff" -> "agat_normalize";
  "braker4_gff" -> "final_filter";
  "braker4_gff" -> "refine";
  "braker4_inputs" -> "braker4";
  "edta" -> "final_filter";
  "edta" -> "refine";
  "edta" -> "repeatmasker";
  "eggnog" -> "merge_function";
  "eviann" -> "eviann_split";
  "eviann_reads" -> "eviann";
  "eviann_split" -> "agat_normalize";
  "eviann_split" -> "final_names";
  "eviann_split" -> "refine";
  "evm" -> "refine";
  "evm_impl_check" -> "evm";
  "evm_impl_check" -> "evm_tune_run";
  "evm_inputs" -> "evm";
  "evm_inputs" -> "evm_tune_inputs";
  "evm_tune_inputs" -> "evm_tune_run";
  "evm_tune_inputs" -> "evm_tune_score";
  "evm_tune_run" -> "evm_tune_score";
  "evm_tune_score" -> "evm";
  "evm_tune_weights" -> "evm_tune_run";
  "evm_tune_weights" -> "evm_tune_score";
  "fastp" -> "hisat2_align";
  "final_export" -> "final_longest";
  "final_export" -> "merge_function";
  "final_filter" -> "final_names";
  "final_longest" -> "eggnog";
  "final_longest" -> "func_split";
  "final_names" -> "final_export";
  "final_pep" -> "final_tesorter";
  "final_tesorter" -> "final_filter";
  "func_split" -> "interproscan";
  "func_split" -> "interproscan_setup";
  "gemoma" -> "gemoma_gff";
  "gemoma_gff" -> "agat_normalize";
  "gemoma_gff" -> "refine";
  "genome_input" -> "final_export";
  "genome_input" -> "final_longest";
  "genome_input" -> "rename_seqids";
  "hisat2_align" -> "merge_bam";
  "hisat2_index" -> "hisat2_align";
  "homolog_clean" -> "gemoma";
  "homolog_clean" -> "homolog_prep";
  "homolog_prep" -> "protein_db";
  "interproscan" -> "merge_function";
  "interproscan_setup" -> "interproscan";
  "lr_read_chains" -> "evm_tune_score";
  "lr_read_chains" -> "refine";
  "lr_sample_chains" -> "lr_read_chains";
  "merge_bam" -> "braker4_inputs";
  "merge_bam" -> "eviann";
  "merge_bam" -> "eviann_reads";
  "merge_bam" -> "gemoma";
  "merge_bam" -> "stringtie";
  "minimap2_align" -> "lr_sample_chains";
  "minimap2_align" -> "merge_bam";
  "miniprot" -> "evm_inputs";
  "miniprot" -> "evm_tune_score";
  "miniprot" -> "refine";
  "protein_db" -> "braker4_inputs";
  "protein_db" -> "edta";
  "protein_db" -> "eviann";
  "protein_db" -> "miniprot";
  "refine" -> "final_filter";
  "refine" -> "final_pep";
  "rename_seqids" -> "braker4_inputs";
  "rename_seqids" -> "edta";
  "rename_seqids" -> "eviann";
  "rename_seqids" -> "evm";
  "rename_seqids" -> "evm_tune_inputs";
  "rename_seqids" -> "final_export";
  "rename_seqids" -> "final_names";
  "rename_seqids" -> "final_pep";
  "rename_seqids" -> "gemoma";
  "rename_seqids" -> "hisat2_index";
  "rename_seqids" -> "minimap2_align";
  "rename_seqids" -> "miniprot";
  "rename_seqids" -> "refine";
  "rename_seqids" -> "repeatmasker";
  "repeat_famdb_setup" -> "edta";
  "repeat_famdb_setup" -> "repeatmasker";
  "repeatmasker" -> "braker4_inputs";
  "repeatmasker" -> "evm_inputs";
  "stringtie" -> "evm_inputs";
  "stringtie" -> "final_filter";
  "stringtie" -> "refine";
  "final_export" -> report [style=dashed];
  "merge_function" -> report [style=dashed];
}
