digraph workflow {
  graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=14, nodesep=0.25, ranksep=0.4, labelloc=t, label="主流程（有 RNA-seq：短读 + 长读）/ Main workflow (with RNA-seq)", compound=true];
  node [shape=box, style="rounded,filled", fillcolor=white, fontname="DejaVu Sans", fontsize=11];
  edge [color="#8a8a8a", arrowsize=0.6];
  subgraph cluster_0 { label="00_Data 输入与预处理 / Input"; style="rounded,filled"; fillcolor="#e8f1fb"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "fastp" [label="fastp"];
    "genome_input" [label="genome_input"];
    "homolog_clean" [label="homolog_clean"];
    "homolog_prep" [label="homolog_prep"];
    "protein_db" [label="protein_db"];
    "rename_seqids" [label="rename_seqids"];
  }
  subgraph cluster_1 { label="01_Repeat 重复序列 / Repeats"; style="rounded,filled"; fillcolor="#fdf0e3"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "edta" [label="edta"];
    "repeat_famdb_setup" [label="repeat_famdb_setup"];
    "repeatmasker" [label="repeatmasker"];
  }
  subgraph cluster_2 { label="02_RNA 比对与 EviAnn / RNA"; style="rounded,filled"; fillcolor="#e9f6ec"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "eviann" [label="eviann"];
    "eviann_reads" [label="eviann_reads"];
    "eviann_split" [label="eviann_split"];
    "hisat2_align" [label="hisat2_align"];
    "hisat2_index" [label="hisat2_index"];
    "lr_read_chains" [label="lr_read_chains"];
    "lr_sample_chains" [label="lr_sample_chains"];
    "merge_bam" [label="merge_bam"];
    "minimap2_align" [label="minimap2_align"];
    "stringtie" [label="stringtie"];
  }
  subgraph cluster_3 { label="03_Ab_initio BRAKER4"; style="rounded,filled"; fillcolor="#f3ecfa"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "braker4" [label="braker4"];
    "braker4_gff" [label="braker4_gff"];
    "braker4_inputs" [label="braker4_inputs"];
  }
  subgraph cluster_4 { label="04_Homology 同源注释 / Homology"; style="rounded,filled"; fillcolor="#fbeef0"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "gemoma" [label="gemoma"];
    "gemoma_ere" [label="gemoma_ere"];
    "gemoma_merge" [label="gemoma_merge"];
    "gemoma_species_gff" [label="gemoma_species_gff"];
    "miniprot" [label="miniprot"];
    "miniprot_index" [label="miniprot_index"];
    "miniprot_merge" [label="miniprot_merge"];
  }
  subgraph cluster_5 { label="05_EVM 整合·调优·修正·最终 / Integration"; style="rounded,filled"; fillcolor="#fff8dc"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "agat_normalize" [label="agat_normalize"];
    "evm" [label="evm"];
    "evm_impl_check" [label="evm_impl_check"];
    "evm_inputs" [label="evm_inputs"];
    "evm_tune_inputs" [label="evm_tune_inputs"];
    "evm_tune_run" [label="evm_tune_run"];
    "evm_tune_score" [label="evm_tune_score"];
    "evm_tune_weights" [label="evm_tune_weights"];
    "final_export" [label="final_export"];
    "final_filter" [label="final_filter"];
    "final_names" [label="final_names"];
    "final_pep" [label="final_pep"];
    "final_select_longest" [label="final_select_longest"];
    "final_tesorter" [label="final_tesorter"];
    "refine" [label="refine"];
  }
  subgraph cluster_6 { label="06_Function 功能注释 / Function"; style="rounded,filled"; fillcolor="#eaf4f4"; color="#bbbbbb"; fontname="Noto Sans CJK SC";
    "eggnog" [label="eggnog"];
    "func_split" [label="func_split"];
    "interproscan" [label="interproscan"];
    "interproscan_setup" [label="interproscan_setup"];
    "kegg_pathway_names" [label="kegg_pathway_names"];
    "merge_function" [label="merge_function"];
  }
  report [label="07_Report 图文报告 / report\n（汇总各步骤统计与 BUSCO / OMArk / AGAT 质控）", fillcolor="#f0f0f0", fontname="Noto Sans CJK SC"];
  "gemoma_species_gff" -> report [style=dashed];
  "kegg_pathway_names" -> report [style=dashed];
  "merge_function" -> report [style=dashed];
  "agat_normalize" -> "evm_inputs";
  "braker4" -> "braker4_gff";
  "braker4_gff" -> "agat_normalize";
  "braker4_gff" -> "final_filter";
  "braker4_gff" -> "refine";
